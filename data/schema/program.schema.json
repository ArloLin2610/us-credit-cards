{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rewards programs and point valuations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "programs"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "name",
        "url",
        "as_of"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "zh"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "zh": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Bilingual text: English and Traditional Chinese"
        }
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "unit",
          "cpp",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Bilingual text: English and Traditional Chinese"
          },
          "kind": {
            "enum": [
              "cash",
              "transferable",
              "bank",
              "airline",
              "hotel",
              "restricted"
            ]
          },
          "unit": {
            "enum": [
              "points",
              "miles",
              "usd"
            ]
          },
          "cpp": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3,
            "description": "Estimated value in US cents per point/mile"
          },
          "basis": {
            "enum": [
              "nerdwallet",
              "issuer",
              "fixed",
              "assumed"
            ]
          },
          "note": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Bilingual text: English and Traditional Chinese"
          }
        }
      }
    }
  }
}