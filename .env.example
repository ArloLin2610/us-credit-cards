# Needed only for the automated checker's LLM extraction (scripts/check-updates.mjs).
# Without it the checker still detects page changes and opens a review PR, but
# does not draft data edits.
ANTHROPIC_API_KEY=
# Optional: override the model used for extraction.
LLM_MODEL=claude-sonnet-5-5
# Optional: site origin and sub-path. The GitHub Pages deploy workflow sets both automatically.
SITE_URL=
BASE_PATH=
# Optional: use an installed Chrome for JavaScript-rendered issuer pages instead of Playwright's download.
CHROME_PATH=
