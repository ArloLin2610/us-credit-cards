---
import type { Card, Lang } from '../lib/types';
import { REWARD_TYPE_LABEL, STATUS_LABEL, TAG_LABEL, UI, href, tr } from '../lib/i18n';
import { cardImage, toSummary } from '../lib/data';

interface Props {
  card: Card;
  lang: Lang;
  showIssuer?: boolean;
}
const { card, lang, showIssuer = true } = Astro.props;
const t = UI[lang];
const s = toSummary(card, lang);
const img = cardImage(card);
const rewardClass = `reward-${card.reward_type === 'cashback' ? 'cash' : card.reward_type}`;
const inactive = card.status !== 'active';
---

<a href={href(lang, `/cards/${card.id}`)} class:list={['tile block p-3', { 'opacity-70': inactive }]}>
  <div class="card-face">
    <img src={img.src} alt={`${card.name} ${t.ex.cardArt}`} loading="lazy" decoding="async" width="320" height="202" />
    {inactive && <span class="absolute left-2 top-2 rounded-md bg-danger-soft px-2 py-0.5 text-xs font-semibold text-danger">{tr(STATUS_LABEL[card.status], lang)}</span>}
  </div>
  <div class="mt-3 flex items-start justify-between gap-2">
    <div class="min-w-0">
      {showIssuer && <div class="text-xs text-ink-soft">{s.issuerName}</div>}
      <h3 class="line-clamp-2 text-base font-bold leading-snug">{card.name}</h3>
    </div>
    <span class:list={['shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold', rewardClass]}>{tr(REWARD_TYPE_LABEL[card.reward_type], lang)}</span>
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-2">
    <span class="text-2xl font-black tracking-tight">{s.topRate}{s.topEquivText && <span class="ml-1.5 text-xs font-medium text-ink-soft" title={t.ex.estTitle}>{s.topEquivText}</span>}</span>
    <span class="text-xs text-ink-soft">{s.annualFee === 0 ? t.ex.noFeeShort : t.ex.feeShort(s.feeText)}</span>
  </div>
  <div class="text-xs text-ink-soft">{s.topLabel}{s.baseText && ` · ${s.baseText}`}</div>
  <div class="mt-2 flex flex-wrap gap-1">
    {s.tags.filter((x) => x !== 'no-annual-fee').slice(0, 3).map((x) => <span class="rounded bg-paper-2 px-1.5 py-0.5 text-[11px] text-ink-soft">{tr(TAG_LABEL[x], lang)}</span>)}
  </div>
</a>
