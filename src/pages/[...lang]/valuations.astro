---
import Base from '../../layouts/Base.astro';
import { programs, valuationSource, cards } from '../../lib/data';
import { BASIS_LABEL, PROGRAM_KIND_LABEL, UI, langFromParam, langPaths, tr } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = UI[lang].val;
const used = new Set(cards.map((c) => c.program));
const order = ['transferable', 'bank', 'airline', 'hotel', 'restricted'];
const rows = programs.filter((p) => p.kind !== 'cash' && used.has(p.id)).sort((a, b) => order.indexOf(a.kind) - order.indexOf(b.kind) || b.cpp - a.cpp);
---

<Base lang={lang} title={t.title} description={t.desc}>
  <section class="mx-auto max-w-4xl px-4 pb-24 pt-10">
    <h1 class="text-3xl font-black tracking-tight md:text-4xl">{t.title}</h1>
    <p class="mt-4 max-w-prose">{t.intro}</p>
    <p class="mt-3 max-w-prose rounded-xl border border-points/30 bg-points-soft px-4 py-3 text-sm">{t.warn}</p>
    <div class="mt-8 overflow-x-auto">
      <table class="spec min-w-[640px]">
        <thead>
          <tr><th>{t.program}</th><th>{t.kind}</th><th>{t.value}</th><th>{t.basis}</th></tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <th scope="row">{tr(p.name, lang)}{p.note && <div class="mt-1 text-xs font-normal text-ink-soft">{tr(p.note, lang)}</div>}</th>
              <td>{tr(PROGRAM_KIND_LABEL[p.kind], lang)}</td>
              <td class="whitespace-nowrap font-bold tabular-nums">{p.unit === 'usd' ? '$1.00' : `${p.cpp.toFixed(1)}¢`}</td>
              <td>{tr(BASIS_LABEL[p.basis], lang)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 max-w-prose text-sm text-ink-soft">
      {t.sourceLine(valuationSource.name, valuationSource.as_of)} <a class="underline" href={valuationSource.url} target="_blank" rel="noopener nofollow">nerdwallet.com</a>
    </p>
    <p class="mt-2 max-w-prose text-sm text-ink-soft">{tr(valuationSource.method, lang)}</p>
  </section>
</Base>
