---
import Base from '../../layouts/Base.astro';
import CompareTable from '../../components/CompareTable.tsx';
import { cards, toCompare } from '../../lib/data';
import { UI, langFromParam, langPaths } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = UI[lang].cmp;
const payload = cards.map((c) => toCompare(c, lang));
---

<Base lang={lang} title={t.title} description={t.intro} noindex>
  <section class="mx-auto max-w-6xl px-4 pb-6 pt-10">
    <h1 class="text-3xl font-black tracking-tight md:text-4xl">{t.title}</h1>
    <p class="mt-3 max-w-prose text-ink-soft">{t.intro}</p>
  </section>
  <section class="mx-auto max-w-6xl px-4 pb-24">
    <CompareTable client:load lang={lang} cards={payload} />
  </section>
</Base>
