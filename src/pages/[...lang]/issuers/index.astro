---
import Base from '../../../layouts/Base.astro';
import IssuerChip from '../../../components/IssuerChip.astro';
import { issuers, cardsOfIssuer, hiddenCount } from '../../../lib/data';
import { UI, href, langFromParam, langPaths } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = UI[lang];
---

<Base lang={lang} title={t.iss.title} description={t.iss.desc}>
  <section class="mx-auto max-w-6xl px-4 pb-24 pt-10">
    <h1 class="text-3xl font-black tracking-tight md:text-4xl">{t.iss.title}</h1>
    <p class="mt-3 max-w-prose text-ink-soft">{t.iss.desc}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {issuers.map((b) => {
        const n = cardsOfIssuer(b.id).filter((c) => c.status === 'active').length;
        const h = hiddenCount(b.id);
        return (
          <li>
            <a href={href(lang, `/issuers/${b.id}`)} class="tile flex items-center gap-4 p-4">
              <IssuerChip issuer={b} />
              <span class="min-w-0">
                <span class="block font-bold">{b.name}</span>
                <span class="block text-sm text-ink-soft">{lang === 'zh' && b.name_zh ? `${b.name_zh}・` : ''}{t.iss.cards(n)}{h > 0 && ` · ${t.iss.hidden(h)}`}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>
