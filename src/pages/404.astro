---
import Base from '../layouts/Base.astro';
import { UI, href } from '../lib/i18n';
const en = UI.en.nf;
const zh = UI.zh.nf;
---

<Base lang="en" title={en.title} noindex>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-3xl font-black tracking-tight">{en.title}</h1>
    <p class="mt-3 text-ink-soft">{en.body}</p>
    <p class="mt-6"><a href={href('en', '/')} class="btn btn-primary">{en.back}</a></p>
    <hr class="my-10 border-line" />
    <p class="text-xl font-bold" lang="zh-Hant">{zh.title}</p>
    <p class="mt-2 text-ink-soft" lang="zh-Hant">{zh.body}</p>
    <p class="mt-4"><a href={href('zh', '/')} class="btn btn-ghost" lang="zh-Hant">{zh.back}</a></p>
  </section>
</Base>
